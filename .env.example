GH_TOKEN=ghp_your_token_here
GITHUB_REPO=your-user/boxtoplay-v2
GIST_ID=your_gist_id_here
# Une cle par compte BoxToPlay: le serveur live alterne entre les deux comptes,
# et une cle ne voit que les serveurs de son propre compte.
BTP_API_KEY_0=btp_live_cle_du_compte_0
BTP_API_KEY_1=btp_live_cle_du_compte_1
BOXTOPLAY_SERVER_ID=951457
# Mot de passe des pages Modpacks/Sauvegardes (le tableau de bord reste public).
# Le changer deconnecte toutes les sessions.
DASHBOARD_MASTER_PASSWORD=choisis_un_mot_de_passe_long
